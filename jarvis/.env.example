# =============================================================================
# JARVIS Desktop AI Assistant — Environment Variables
#
# Copy this file to jarvis/.env and fill in all required values:
#   cp .env.example .env
#
# Required keys are marked with [REQUIRED].
# All other fields have sensible defaults and can be left as-is for a quick
# local trial.
# =============================================================================


# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

# Application display name (informational only)
APP_NAME=JARVIS

# Semantic version (informational only)
VERSION=1.0.0

# Enable verbose logging and SQL echo (set to false in production)
DEBUG=false

# Runtime environment — affects log format and file sink
# One of: development | production
ENVIRONMENT=production

# Log level for stdout and file sinks
# One of: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Secret key for signing JWT tokens issued by the REST API
# Generate a strong value with: openssl rand -hex 32
# [REQUIRED for API auth — use the default only for local testing]
API_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32


# ---------------------------------------------------------------------------
# REST API Server
# ---------------------------------------------------------------------------

# Interface to bind uvicorn to (0.0.0.0 = all interfaces)
API_HOST=0.0.0.0

# Port the FastAPI server listens on
API_PORT=8765


# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# SQLAlchemy async connection URL.
# SQLite (local file, zero configuration):
DATABASE_URL=sqlite+aiosqlite:///./jarvis.db

# PostgreSQL alternative (requires asyncpg):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/jarvisdb


# ---------------------------------------------------------------------------
# OpenAI
# ---------------------------------------------------------------------------

# [REQUIRED] Your OpenAI API key — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Chat model to use for JARVIS responses
# Recommended: gpt-4o (best quality) | gpt-4o-mini (faster / cheaper)
OPENAI_MODEL=gpt-4o

# Maximum tokens per completion request
OPENAI_MAX_TOKENS=2048

# Sampling temperature  (0.0 = deterministic, 1.0 = very creative)
OPENAI_TEMPERATURE=0.7


# ---------------------------------------------------------------------------
# Telegram (Telethon userbot — optional)
# ---------------------------------------------------------------------------
# JARVIS uses a Telethon *userbot* (logs in as YOUR Telegram account), not a
# bot token.  This lets it read and send messages just like you would.
#
# Obtain API credentials at https://my.telegram.org/apps
# Leave API_ID=0 or API_HASH empty to disable Telegram integration entirely.

# [REQUIRED for Telegram] Integer application ID
TELEGRAM_API_ID=0

# [REQUIRED for Telegram] Hex application hash
TELEGRAM_API_HASH=

# Phone number registered on Telegram (E.164 format, e.g. +14155552671)
TELEGRAM_PHONE=+1234567890

# Path to the Telethon session file (without extension)
# The file is created automatically on the first successful login.
TELEGRAM_SESSION=/tmp/jarvis_telegram


# ---------------------------------------------------------------------------
# Voice — Speech-to-Text (Whisper)
# ---------------------------------------------------------------------------

# Whisper model size for local transcription.
# Tradeoff: accuracy vs. RAM / speed
#   tiny   — fastest,  ~75 MB RAM,  lower accuracy
#   base   — fast,    ~150 MB RAM,  good accuracy   [default]
#   small  — medium,  ~500 MB RAM,  better accuracy
#   medium — slow,   ~1.5 GB RAM,  high accuracy
#   large  — slowest, ~3 GB RAM,   best accuracy
WHISPER_MODEL=base


# ---------------------------------------------------------------------------
# Voice — Text-to-Speech (Edge TTS)
# ---------------------------------------------------------------------------

# Microsoft Edge TTS voice name.
# Browse available voices: edge-tts --list-voices
# Recommended English voices:
#   en-US-GuyNeural      (male, natural)
#   en-US-AriaNeural     (female, natural)
#   en-GB-RyanNeural     (British male)
#   en-AU-WilliamNeural  (Australian male)
TTS_VOICE=en-US-GuyNeural

# Playback speed adjustment relative to the default rate.
# Examples: +10% (faster), -10% (slower), +0% (normal)
VOICE_SPEED=+0%


# ---------------------------------------------------------------------------
# Voice — Microphone / Recording
# ---------------------------------------------------------------------------

# Audio capture sample rate in Hz (16000 is standard for Whisper)
VOICE_SAMPLE_RATE=16000

# Amplitude below which audio is considered silence (0.0–1.0 range of int16 max)
VOICE_SILENCE_THRESHOLD=0.01

# Seconds of continuous silence that trigger end-of-speech detection
VOICE_SILENCE_DURATION=1.5

# Wake word phrase (case-insensitive) — say this to activate JARVIS
WAKE_WORD=jarvis


# ---------------------------------------------------------------------------
# Desktop Automation
# ---------------------------------------------------------------------------

# Enable PyAutoGUI-based desktop control
# Set to false when running in Docker / headless environments
DESKTOP_AUTOMATION_ENABLED=true

# Directory where JARVIS saves screenshots
SCREENSHOT_DIR=/tmp/jarvis_screenshots


# ---------------------------------------------------------------------------
# Memory / Conversation History
# ---------------------------------------------------------------------------

# Maximum number of conversation turns kept in context for the AI model
MAX_CONVERSATION_HISTORY=20

# Local path to the SQLite task database
# (ignored when DATABASE_URL points to PostgreSQL)
TASK_DB_PATH=./jarvis.db
