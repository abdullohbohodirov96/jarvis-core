# =============================================================================
# JARVIS AI Assistant Platform — Environment Variables
#
# Copy this file to .env and fill in all required values before running.
#   cp .env.example .env
#
# Lines prefixed with a comment explain the variable.
# Variables with obvious defaults are pre-filled; secrets are left as placeholders.
# =============================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME=JARVIS
APP_VERSION=1.0.0

# Enable debug mode only in development (exposes /docs, /redoc, verbose errors)
DEBUG=false

# One of: development | staging | production
ENVIRONMENT=production

# JWT secret — generate with: openssl rand -hex 32
SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-chars

# JWT signing algorithm
ALGORITHM=HS256

# Access token lifetime (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Refresh token lifetime (days)
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
# Use host "postgres" when running inside Docker Compose; "localhost" otherwise.
DATABASE_URL=postgresql+asyncpg://jarvis:jarvispassword@postgres:5432/jarvisdb

# SQLAlchemy async connection pool settings
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
# DB 0: general cache / session store
REDIS_URL=redis://redis:6379/0

# DB 1: Celery task broker
CELERY_BROKER_URL=redis://redis:6379/1

# DB 2: Celery result backend
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ---------------------------------------------------------------------------
# OpenAI
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-your-openai-api-key-here

# Model used for chat completions (gpt-4o recommended)
OPENAI_MODEL=gpt-4o

# Maximum completion tokens per request
OPENAI_MAX_TOKENS=4096

# Sampling temperature (0.0 = deterministic, 1.0 = creative)
OPENAI_TEMPERATURE=0.7

# ---------------------------------------------------------------------------
# Telegram (Telethon userbot)
# ---------------------------------------------------------------------------
# Obtain from https://my.telegram.org/apps
TELEGRAM_API_ID=your-telegram-api-id
TELEGRAM_API_HASH=your-telegram-api-hash

# Phone number associated with the Telegram account (E.164 format)
TELEGRAM_PHONE=+1234567890

# Session file name (stored in data/sessions/)
TELEGRAM_SESSION_NAME=jarvis_session

# ---------------------------------------------------------------------------
# Voice Pipeline
# ---------------------------------------------------------------------------
# Whisper model size: base | small | medium | large | large-v2 | large-v3
# Larger = more accurate but slower and more RAM-intensive
WHISPER_MODEL=base

# Set to true to use OpenAI Whisper API instead of local inference
WHISPER_USE_API=false

# ElevenLabs (premium TTS) — leave blank to disable
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_ID=your-voice-id

# TTS provider: "edge" (free, Microsoft) | "elevenlabs" (premium)
TTS_PROVIDER=edge

# Microsoft Edge TTS voice name
EDGE_TTS_VOICE=en-US-AriaNeural

# Audio capture sample rate (Hz)
VOICE_SAMPLE_RATE=16000

# Microphone capture chunk size (seconds)
VOICE_CHUNK_DURATION=0.5

# ---------------------------------------------------------------------------
# Memory System
# ---------------------------------------------------------------------------
# Maximum number of memory entries to keep per user
MAX_MEMORY_ITEMS=1000

# Hours before a memory item is eligible for decay / pruning (720 = 30 days)
MEMORY_DECAY_HOURS=720

# Importance score threshold below which memories are not persisted (0.0–1.0)
MEMORY_IMPORTANCE_THRESHOLD=0.3

# ---------------------------------------------------------------------------
# Celery Workers & Scheduled Jobs
# ---------------------------------------------------------------------------
# How often to check for due reminders (seconds)
REMINDER_CHECK_INTERVAL=60

# Hour (0–23, UTC) to send the daily summary
DAILY_SUMMARY_HOUR=9

# Hour (0–23, UTC) to send the morning briefing
MORNING_BRIEFING_HOUR=8

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# JSON array of allowed origins
# Add your frontend origin here (e.g. https://app.yourdomain.com)
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# One of: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Log output format: "json" (production) | "console" (development)
LOG_FORMAT=json

# ---------------------------------------------------------------------------
# Rate Limiting
# ---------------------------------------------------------------------------
# Maximum requests per IP per window
RATE_LIMIT_REQUESTS=100

# Window duration in seconds
RATE_LIMIT_WINDOW=60
